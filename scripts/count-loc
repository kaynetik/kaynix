#!/usr/bin/env bash
# Count lines of code by file extension under the current directory.
#
# Usage: count-loc [ext ...]
#   count-loc            # default extension set below
#   count-loc nix lua    # only these extensions
#
# Skips VCS metadata, dependency, and build-output directories. One find pass;
# aggregation happens in awk, so filenames with spaces are handled.
set -euo pipefail

GREEN='\033[0;32m'
PURPLE='\033[0;35m'
NC='\033[0m'

exts=("$@")
if [ "${#exts[@]}" -eq 0 ]; then
  exts=(nix lua go swift sh zsh md yaml yml toml bzl bazel)
fi

prune_dirs=(.git node_modules vendor .direnv .cache target dist build result)

prune_expr=()
for d in "${prune_dirs[@]}"; do
  prune_expr+=(-o -name "$d")
done

name_expr=()
for e in "${exts[@]}"; do
  name_expr+=(-o -name "*.$e")
done

printf '%b\n' "${GREEN}Lines of code under $(pwd)${NC}"
printf 'extensions: %s\n\n' "${exts[*]}"

find . \( "${prune_expr[@]:1}" \) -prune -o -type f \( "${name_expr[@]:1}" \) -print0 |
  xargs -0 -r wc -l 2>/dev/null |
  awk -v purple="$PURPLE" -v nc="$NC" '
    # Selection sort of keys[0..n-1], descending by vals[key]; small n only.
    function sort_desc(keys, vals, n,    i, j, max, t) {
      for (i = 0; i < n; i++) {
        max = i
        for (j = i + 1; j < n; j++)
          if (vals[keys[j]] > vals[keys[max]]) max = j
        t = keys[i]; keys[i] = keys[max]; keys[max] = t
      }
    }
    {
      lines = $1
      $1 = ""
      file = substr($0, 2)
      if (file == "total" || file == "") next

      ext = file
      sub(/.*\./, "", ext)
      ext_lines[ext] += lines
      ext_files[ext]++

      dir = file
      sub(/^\.\//, "", dir)
      if (dir ~ /\//) sub(/\/.*/, "", dir); else dir = "."
      dir_lines[dir] += lines

      total_lines += lines
      total_files++
    }
    END {
      n = 0
      for (e in ext_lines) ekeys[n++] = e
      sort_desc(ekeys, ext_lines, n)
      for (i = 0; i < n; i++)
        printf "%-8s %6d files %10d lines\n", ekeys[i] ":", ext_files[ekeys[i]], ext_lines[ekeys[i]]

      printf "------------------------------\n"
      printf "%sTOTAL:   %6d files %10d lines%s\n\n", purple, total_files, total_lines, nc

      m = 0
      for (d in dir_lines) dkeys[m++] = d
      sort_desc(dkeys, dir_lines, m)
      printf "Top directories by line count:\n"
      for (i = 0; i < m && i < 10; i++)
        printf "%10d  %s\n", dir_lines[dkeys[i]], dkeys[i]
    }
  '
