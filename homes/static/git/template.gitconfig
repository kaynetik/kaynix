# Per-directory git identity template. Copy it next to a tree of checkouts and
# wire it up with an includeIf in ~/.gitconfig, e.g.:
#   [includeIf "gitdir:~/Development/Work/"]
#       path = ~/Development/Work/.gitconfig
# Canonical values live in modules/home/identity.nix (kaynix.identity); update
# both places when the identity changes.
[user]
    name = kaynetik
    email = aleksandar@nesovic.dev
    signingkey = FC04210D2782C032

[commit]
    gpgsign = true

[tag]
    gpgsign = true
